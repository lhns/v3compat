#!/bin/sh
# v3compat-run [--] prog args...   Run prog under DynamoRIO with the v3compat client.
# drrun execs the program in place, so the exit status and signals are the program's own.
# Policy lives here: V3COMPAT_NATIVE=1 skips DynamoRIO, even on a CPU that needs it.
#   V3COMPAT_DR_OPTS   extra DynamoRIO options, appended to DEFAULT_DR_OPTS
#   V3COMPAT_STATS=1   client prints executed per-class and per-opcode totals to stderr at exit
#   V3COMPAT_HELPERS_ONLY=1   no inline expansions, to compare them with the helpers
set -eu

# The one place to change DynamoRIO's defaults.
DEFAULT_DR_OPTS=""

[ "${1:-}" = "--" ] && shift
if [ $# -eq 0 ]; then echo "usage: v3compat-run [--] prog [args...]" >&2; exit 2; fi
[ "${V3COMPAT_NATIVE:-}" = 1 ] && exec "$@"

here=$(dirname "$(readlink -f "$0")")
lib=$here/../libexec/v3compat
dr=$lib/dynamorio

# drrun keeps per-process config files; $HOME may be read-only or absent in containers.
if [ -z "${DYNAMORIO_CONFIGDIR:-}" ]; then
  cfg=${TMPDIR:-/tmp}/v3compat-$(id -u)
  mkdir -m 700 -p "$cfg"
  if [ -L "$cfg" ] || [ ! -O "$cfg" ]; then echo "v3compat-run: $cfg is not ours" >&2; exit 1; fi
  export DYNAMORIO_CONFIGDIR=$cfg
fi

client_opts=""
[ "${V3COMPAT_STATS:-}" = 1 ] && client_opts="-stats"
[ "${V3COMPAT_HELPERS_ONLY:-}" = 1 ] && client_opts="$client_opts -helpers-only"

# Unquoted on purpose: both option lists are space-separated words.
set -f
# shellcheck disable=SC2086
exec "$dr/bin64/drrun" -quiet -root "$dr" $DEFAULT_DR_OPTS ${V3COMPAT_DR_OPTS:-} \
  -c "$lib/libv3compat.so" $client_opts -- "$@"
